<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<!-- Nombre visible en la pantalla de inicio del iPhone -->
	<key>CFBundleDisplayName</key>
	<string>TILA</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Evita el cuestionario de cifrado en exportación — TILA usa solo HTTPS estándar -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Esquemas externos que la app necesita poder consultar (AppLauncher) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>waze</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- arm64 requerido por App Store (todos los iPhones desde 5s) -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- iPhone: Portrait principal, Landscape permitido para mapas -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- iPad: todas las orientaciones -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Ubicación GPS — seguimiento de viaje activo -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TILA necesita tu ubicación para mostrar el seguimiento del viaje.</string>

	<!-- Cámara — evidencias fotográficas de retiro y entrega -->
	<key>NSCameraUsageDescription</key>
	<string>TILA necesita la cámara para registrar evidencias de carga y entrega.</string>

	<!-- Fotos — adjuntar evidencias desde la galería -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TILA necesita acceso a fotos para adjuntar evidencias del servicio.</string>

	<!-- Guardar fotos — evidencias de retiro y entrega -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TILA guarda evidencias de retiro y entrega en tu galería.</string>

</dict>
</plist>
