# Plantilla de variables para STAGING de TILA. NO contiene valores reales.
# Copiar a `.env.staging` (git-ignorado por el patrón `.env*`) y completar con claves de un proyecto Supabase DISTINTO de producción.
# NUNCA reutilizar claves de producción. Las claves no se pasan por argumentos de línea de comandos.

# ── Guardas (obligatorias: los scripts de scripts/staging/ abortan si faltan o apuntan a producción) ──────────────
TILA_ENTORNO=staging
TILA_STAGING_SUPABASE_REF=            # ref del proyecto de staging (la parte antes de .supabase.co). Lista separada por comas.
TILA_STAGING_APP_HOSTS=               # hosts de la app de staging fuera de localhost (p. ej. tila-staging.vercel.app)

# ── Supabase de STAGING (proyecto separado) ────────────────────────────────────────────────────────────────────
STAGING_SUPABASE_URL=https://<ref-staging>.supabase.co
STAGING_ANON_KEY=                     # clave pública (anon / publishable) del proyecto de staging
STAGING_SERVICE_ROLE_KEY=             # clave SECRETA (service_role / secret) del proyecto de staging — solo seed y servidor

# ── Variables que lee la APP (se cargan explícitamente al levantar staging; NO usar .env.local de producción) ─────
NEXT_PUBLIC_SUPABASE_URL=${STAGING_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${STAGING_ANON_KEY}
SUPABASE_URL=${STAGING_SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${STAGING_SERVICE_ROLE_KEY}
TILA_SESSION_SECRET=                  # ≥ 32 caracteres, propio de staging (openssl rand -base64 48). Distinto al de producción.
TILA_AUTH_MODE=legacy                 # legacy | dual | strict (una instancia por modo)
NEXT_PUBLIC_BASE_URL=                 # URL pública de la app de staging (back_urls / webhook de Mercado Pago)

# ── Google (opcional en la fase 1: sin claves, MapaTILA muestra error pero los flujos de API funcionan) ───────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=      # clave de STAGING, restringida por referrer (localhost + host de staging) y por API
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_SERVER_API_KEY=                # clave de STAGING con cuota baja

# ── Mercado Pago (SANDBOX: credenciales TEST-… de una cuenta de prueba; nunca APP_USR-… de producción) ────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
